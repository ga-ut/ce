{
  "name": "@ga-ut/ce",
  "version": "0.1.1",
  "description": "Custom Elements runtime with signals, routing, and dependency-free app bundling",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ga-ut/ce.git",
    "directory": "packages/ce"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "bin": {
    "ce-cli": "dist/cli/index.mjs"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.mjs",
      "require": "./dist/core/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.mjs",
      "require": "./dist/web/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.mjs",
      "require": "./dist/cli/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/core/index.ts src/web/index.ts src/cli/index.ts --format esm,cjs --dts --clean",
    "pack:check": "bun pm pack --dry-run"
  }
}
